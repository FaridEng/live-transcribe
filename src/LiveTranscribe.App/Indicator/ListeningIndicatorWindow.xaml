<Window x:Class="LiveTranscribe.App.Indicator.ListeningIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveTranscribe listening"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        IsHitTestVisible="False">
    <Border Background="#F21F1F23"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Padding="10,5">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FF5A5A" VerticalAlignment="Center" />
            <TextBlock Text="Listening"
                       Foreground="White"
                       FontSize="12"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
