<Window x:Class="LiveTranscribe.App.FloatingControl.FloatingControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveTranscribe"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Width="440"
        Height="436"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- The window never changes size and the pill keeps its row, so nothing moves while the user
         hovers. The flyouts live in the transparent 200 px band above the pill, or in the one below
         it when the pill sits near the top of a screen (T11). Empty area is click-through. -->
    <Grid HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="AboveStack" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">

        <!-- State details and warnings -->
        <Border x:Name="Bubble"
                Visibility="Collapsed"
                Background="#F21F1F23"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,7"
                Margin="0,0,0,6"
                MaxWidth="380"
                MaxHeight="96"
                HorizontalAlignment="Center">
            <TextBlock x:Name="BubbleText"
                       Foreground="White"
                       FontSize="13"
                       FontFamily="Vazirmatn, Segoe UI"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Pill menu, opened with a right-click: the microphone picker (FR-7.1) and Settings. It lives
             inside this window rather than in a popup, because a popup would take focus away from the
             target. -->

        <Border x:Name="MicrophoneMenu"
                Visibility="Collapsed"
                Background="#F21F1F23"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6"
                Margin="0,0,0,6"
                MaxWidth="380"
                HorizontalAlignment="Center"
                MouseLeave="OnMicrophoneMenuLeave">
            <ScrollViewer MaxHeight="184" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MicrophoneList" />
            </ScrollViewer>
        </Border>

        <!-- Recovery offers: kept text (FR-9.3), retry of kept audio (FR-9.1), and the way out of a
             microphone blocked by Windows privacy settings (FR-7.5). Only the ones that apply show. -->
        <Border x:Name="Recovery"
                Visibility="Collapsed"
                Background="#F21F1F23"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="5,6"
                Margin="0,0,0,6"
                HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="RetryButton"
                        Visibility="Collapsed"
                        Background="#33FFFFFF"
                        CornerRadius="8"
                        Padding="10,4"
                        Margin="3,0"
                        Cursor="Hand"
                        ToolTip="Send the recording again - no need to repeat it"
                        MouseLeftButtonDown="OnRecoveryMouseDown"
                        MouseLeftButtonUp="OnRetryMouseUp">
                    <TextBlock Text="Retry" Foreground="White" FontSize="12" FontFamily="Segoe UI" />
                </Border>
                <Border x:Name="PrivacyButton"
                        Visibility="Collapsed"
                        Background="#33FFFFFF"
                        CornerRadius="8"
                        Padding="10,4"
                        Margin="3,0"
                        Cursor="Hand"
                        ToolTip="Open the Windows page that allows microphone access"
                        MouseLeftButtonDown="OnRecoveryMouseDown"
                        MouseLeftButtonUp="OnPrivacyMouseUp">
                    <TextBlock Text="Open privacy settings" Foreground="White" FontSize="12" FontFamily="Segoe UI" />
                </Border>
                <Border x:Name="PasswordButton"
                        Visibility="Collapsed"
                        Background="#33FFFFFF"
                        CornerRadius="8"
                        Padding="10,4"
                        Margin="3,0"
                        Cursor="Hand"
                        ToolTip="Allow this one dictation into the password field"
                        MouseLeftButtonDown="OnRecoveryMouseDown"
                        MouseLeftButtonUp="OnPasswordOverrideMouseUp">
                    <TextBlock Text="Dictate anyway" Foreground="White" FontSize="12" FontFamily="Segoe UI" />
                </Border>
                <Border x:Name="PasswordDeclineButton"
                        Visibility="Collapsed"
                        Background="#33FFFFFF"
                        CornerRadius="8"
                        Padding="10,4"
                        Margin="3,0"
                        Cursor="Hand"
                        ToolTip="Leave the password field alone"
                        MouseLeftButtonDown="OnRecoveryMouseDown"
                        MouseLeftButtonUp="OnPasswordDeclineMouseUp">
                    <TextBlock Text="Not now" Foreground="White" FontSize="12" FontFamily="Segoe UI" />
                </Border>
                <Border x:Name="CopyButton"
                        Visibility="Collapsed"
                        Background="#33FFFFFF"
                        CornerRadius="8"
                        Padding="10,4"
                        Margin="3,0"
                        Cursor="Hand"
                        ToolTip="Copy the kept text to the clipboard"
                        MouseLeftButtonDown="OnRecoveryMouseDown"
                        MouseLeftButtonUp="OnCopyMouseUp">
                    <TextBlock Text="Copy" Foreground="White" FontSize="12" FontFamily="Segoe UI" />
                </Border>
                <Border x:Name="PasteButton"
                        Visibility="Collapsed"
                        Background="#33FFFFFF"
                        CornerRadius="8"
                        Padding="10,4"
                        Margin="3,0"
                        Cursor="Hand"
                        ToolTip="Paste the kept text where the caret is now"
                        MouseLeftButtonDown="OnRecoveryMouseDown"
                        MouseLeftButtonUp="OnPasteMouseUp">
                    <TextBlock Text="Paste at caret" Foreground="White" FontSize="12" FontFamily="Segoe UI" />
                </Border>
            </StackPanel>
        </Border>
        </StackPanel>

        <Border x:Name="Pill"
                Grid.Row="1"
                Background="#F21F1F23"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Height="36"
                MinWidth="36"
                Padding="7,0"
                HorizontalAlignment="Center"
                Cursor="Hand"
                MouseLeftButtonDown="OnPillMouseDown"
                MouseMove="OnPillMouseMove"
                MouseLeftButtonUp="OnPillMouseUp"
                MouseRightButtonUp="OnPillRightClick"
                MouseEnter="OnPillMouseEnter"
                MouseLeave="OnPillMouseLeave">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- What a click produces: FA writes down what was said, EN translates it (T14). A dot
                     means a topic note is on. It switches with a click and never starts a dictation. -->
                <Border x:Name="OutputChip"
                        CornerRadius="9"
                        Height="18"
                        MinWidth="26"
                        Padding="5,0"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Background="#33FFFFFF"
                        MouseLeftButtonDown="OnChipMouseDown"
                        MouseLeftButtonUp="OnChipMouseUp">
                    <Grid>
                        <TextBlock x:Name="OutputChipText"
                                   Text="FA"
                                   Foreground="White"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Ellipse x:Name="NoteDot"
                                 Width="5"
                                 Height="5"
                                 Fill="#F2B13D"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,1,-4,0"
                                 Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Grid Width="22" Height="22">
                    <Ellipse x:Name="PulseRing"
                             Stroke="#FF5A5A"
                             StrokeThickness="2"
                             Opacity="0"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PulseScale" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Path x:Name="Glyph"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Stroke="White"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="GlyphRotation" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>

                <StackPanel x:Name="LevelBars"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Height="18"
                            Margin="6,0,0,0"
                            Visibility="Collapsed" />

                <Border x:Name="CancelButton"
                        Visibility="Collapsed"
                        Width="20"
                        Height="20"
                        CornerRadius="10"
                        Margin="8,0,0,0"
                        Background="#33FFFFFF"
                        ToolTip="Cancel (Esc)"
                        MouseLeftButtonDown="OnCancelMouseDown"
                        MouseLeftButtonUp="OnCancelMouseUp">
                    <Path Data="M0,0 L8,8 M8,0 L0,8"
                          Stroke="White"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Empty until a flyout is flipped here, which happens near the top of a screen (T11). -->
        <StackPanel x:Name="BelowStack" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center" />
    </Grid>
</Window>
