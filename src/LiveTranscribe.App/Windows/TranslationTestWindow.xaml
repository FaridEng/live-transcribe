<Window x:Class="LiveTranscribe.App.Windows.TranslationTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Try and compare translation models"
        Width="820" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,6,20,20">
        <TextBlock Text="Context" Style="{StaticResource Section}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Topic note (optional)" Style="{StaticResource Label}" />
                <TextBox x:Name="TopicBox" Height="26" VerticalContentAlignment="Center"
                         FontFamily="Vazirmatn, Segoe UI" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Tone" Style="{StaticResource Label}" />
                <ComboBox x:Name="ToneBox" Height="26" DisplayMemberPath="Name" />
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource Note}"
                   Text="For example: &quot;reply to a client about the delayed release&quot;. Every model below gets the same note and tone, except the interpreting ones, which take neither." />

        <TextBlock Text="Models" Style="{StaticResource Section}" />
        <WrapPanel x:Name="ModelList" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="AddModelBox" Height="26" IsEditable="True" IsTextSearchEnabled="False" />
            <Button Grid.Column="2" Content="Add" Width="70" Height="26" Click="OnAddModel" />
            <Button x:Name="LoadListButton" Grid.Column="4" Content="Load list" Width="90" Height="26" Click="OnLoadList" />
        </Grid>
        <TextBlock x:Name="ModelNote" Style="{StaticResource Note}"
                   Text="Ticked models all hear the same recording at the same time. Two-step models transcribe with your dictation profile first; one-step models hear the audio." />

        <TextBlock Text="Recording" Style="{StaticResource Section}" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="RecordButton" Content="Record" Width="110" Height="28" Click="OnRecord" />
            <Button x:Name="RunAgainButton" Content="Run again" Width="110" Height="28" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnRunAgain"
                    ToolTip="Send the last recording again, at speaking pace, to the ticked models" />
        </StackPanel>
        <ProgressBar x:Name="LevelBar" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="0" />
        <TextBlock x:Name="StatusText" Style="{StaticResource Note}"
                   Text="Press Record, say a sentence or two, press Stop. The recording stays in memory until this window closes." />

        <TextBlock Text="Results" Style="{StaticResource Section}" />
        <StackPanel x:Name="Results" />
        <TextBlock Style="{StaticResource Note}"
                   Text="Time is measured from the end of your speech to the finished English, which is the wait you would feel. Results are shown here only and never written to the log." />
    </StackPanel>
    </ScrollViewer>
</Window>
