<Window x:Class="LiveTranscribe.App.Windows.TopicNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Topic note"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="What are you writing about?" FontWeight="SemiBold" />
        <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"
                   Text="Every translation uses it for word choice and tone, for example &quot;reply to a client about the delayed release&quot;. It clears itself after an hour without translating." />
        <TextBox x:Name="NoteBox" Height="26" VerticalContentAlignment="Center"
                 FontFamily="Vazirmatn, Segoe UI" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="80" Height="26" IsDefault="True" Click="OnSave" />
            <Button x:Name="ClearButton" Content="Clear" Width="80" Height="26" Margin="8,0,0,0" Click="OnClear" />
            <Button Content="Cancel" Width="80" Height="26" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
